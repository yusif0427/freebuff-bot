# Discord bot credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
# Website branding
BOT_NAME=Freebuff Bot
# Invitation link shown on the site (optional)
INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands
PORT=3000
